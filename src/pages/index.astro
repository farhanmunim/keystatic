---
import Layout from '../layouts/Layout.astro';
import PostList from '../components/PostList.astro';
import CatalogueList from '../components/CatalogueList.astro';
import { getCatalogue, getPosts, getSettings, paths } from '../lib/content';

const settings = await getSettings();
const posts = await getPosts();
const featuredPosts = posts.filter((p) => p.data.featured);
const latestPosts = posts.filter((p) => !p.data.featured).slice(0, 3);
const projects = (await getCatalogue('projects')).filter((p) => p.data.featured);
const services = (await getCatalogue('services')).filter((s) => s.data.featured);
const resources = (await getCatalogue('resources')).filter((r) => r.data.featured);
---

<Layout>
  <section>
    <h1>{settings.name}</h1>
    {settings.tagline && <p class="muted">{settings.tagline}</p>}
  </section>

  {featuredPosts.length > 0 && (
    <section>
      <h2>Featured posts</h2>
      <PostList posts={featuredPosts} />
    </section>
  )}

  <section>
    <h2>Latest from the blog</h2>
    <PostList posts={latestPosts} />
    <p><a href={paths.posts}>All posts →</a></p>
  </section>

  {projects.length > 0 && (
    <section>
      <h2>Featured projects</h2>
      <CatalogueList entries={projects} base={paths.projects} />
      <p><a href={paths.projects}>All projects →</a></p>
    </section>
  )}

  {services.length > 0 && (
    <section>
      <h2>Featured services</h2>
      <CatalogueList entries={services} base={paths.services} />
      <p><a href={paths.services}>All services →</a></p>
    </section>
  )}

  {resources.length > 0 && (
    <section>
      <h2>Featured resources</h2>
      <CatalogueList entries={resources} base={paths.resources} />
      <p><a href={paths.resources}>All resources →</a></p>
    </section>
  )}
</Layout>
