---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import CatalogueList from '../../components/CatalogueList.astro';
import { getCatalogue, getPosts, paths } from '../../lib/content';

export async function getStaticPaths() {
  const tags = await getCollection('tags');
  return tags.map((tag) => ({ params: { slug: tag.id }, props: { tag } }));
}

const { tag } = Astro.props;
const tagged = <T extends { data: { tags: string[] } }>(entries: T[]) =>
  entries.filter((e) => e.data.tags.includes(tag.id));

const posts = tagged(await getPosts());
const projects = tagged(await getCatalogue('projects'));
const services = tagged(await getCatalogue('services'));
const resources = tagged(await getCatalogue('resources'));
---

<Layout title={`#${tag.data.name}`} description={`Everything tagged ${tag.data.name}.`}>
  <h1>#{tag.data.name}</h1>
  {posts.length > 0 && (
    <section><h2>Posts</h2><PostList posts={posts} /></section>
  )}
  {projects.length > 0 && (
    <section><h2>Projects</h2><CatalogueList entries={projects} base={paths.projects} /></section>
  )}
  {services.length > 0 && (
    <section><h2>Services</h2><CatalogueList entries={services} base={paths.services} /></section>
  )}
  {resources.length > 0 && (
    <section><h2>Resources</h2><CatalogueList entries={resources} base={paths.resources} /></section>
  )}
  {posts.length + projects.length + services.length + resources.length === 0 && <p class="muted">Nothing tagged yet.</p>}
</Layout>
