# Keystatic GitHub sign-in (production only; local dev needs none of these).
# Create a GitHub App (see README "Setting up CMS sign-in") and copy its values here,
# or run `npm run dev`, open /keystatic and click "Set up GitHub" to generate them.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
